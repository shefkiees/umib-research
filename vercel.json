{
  "functions": {
    "api/index.js": {
      "includeFiles": "backend/**"
    }
  },
  "headers": [
    {
      "source": "/:page(privacy|terms)/:path*",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, follow" }
      ]
    },
    {
      "source": "/:section(admin|professor|committee|prorector|ProRector|dashboard|login|auth|api|backend)/:path*",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/backend/api/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/auth/reset-password",
      "destination": "/index.html"
    },
    {
      "source": "/auth/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
